#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 REPOSITORY COMMIT" >&2
  exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repository="$(realpath "$1")"
commit="$2"
assets="$root/.data/firecracker"

for path in "$assets/vmlinux" "$assets/rootfs.ext4"; do
  test -f "$path" || {
    echo "missing $path; run pnpm prepare:firecracker first" >&2
    exit 2
  }
done

for command in firecracker git jq mke2fs; do
  command -v "$command" >/dev/null || {
    echo "missing $command; enter the Nix development shell with: nix develop" >&2
    exit 2
  }
done

work=$(mktemp -d "$root/.data/firecracker-run.XXXXXX")
# shellcheck disable=SC2329 # Invoked by the EXIT trap.
cleanup() {
  git -C "$repository" worktree remove --force "$work/data/repository" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

mkdir -p "$work/data"
git -C "$repository" worktree add --quiet --detach "$work/data/repository" "$commit"
truncate -s 256M "$work/workspace.ext4"
mke2fs -q -t ext4 -d "$work/data" -F "$work/workspace.ext4"

jq -n \
  --arg kernel "$assets/vmlinux" \
  --arg rootfs "$assets/rootfs.ext4" \
  --arg workspace "$work/workspace.ext4" \
  '{
    "boot-source": {
      "kernel_image_path": $kernel,
      "boot_args": "console=ttyS0 reboot=k panic=1 pci=off quiet loglevel=3 init=/sbin/swarm-guest-init"
    },
    "drives": [
      {
        "drive_id": "rootfs",
        "path_on_host": $rootfs,
        "is_root_device": true,
        "is_read_only": true
      },
      {
        "drive_id": "workspace",
        "path_on_host": $workspace,
        "is_root_device": false,
        "is_read_only": false
      }
    ],
    "machine-config": {
      "vcpu_count": 1,
      "mem_size_mib": 512,
      "smt": false
    }
  }' > "$work/config.json"

set +e
timeout --kill-after=2s 30s firecracker --no-api --config-file "$work/config.json" 2>&1 \
  | tee "$work/console.log"
firecracker_status=${PIPESTATUS[0]}
set -e

result=$(grep -oE '__PI_AGENT_SWARM_RESULT__=[0-9]+' "$work/console.log" | tail -1 | cut -d= -f2 || true)
if [[ -z "$result" ]]; then
  echo "Firecracker exited without a guest result (host status $firecracker_status)" >&2
  exit 125
fi

exit "$result"
