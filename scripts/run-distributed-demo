#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

pnpm build
mkdir -p .data

api_log="$root/.data/execution-api.log"
executor_a_log="$root/.data/executor-a.log"
executor_b_log="$root/.data/executor-b.log"

node dist/execution-api.js >"$api_log" 2>&1 &
api_pid=$!
executor_a_pid=""
executor_b_pid=""

# shellcheck disable=SC2329 # Invoked by the EXIT trap.
cleanup() {
  if [[ -n "$executor_a_pid" ]]; then kill "$executor_a_pid" 2>/dev/null || true; fi
  if [[ -n "$executor_b_pid" ]]; then kill "$executor_b_pid" 2>/dev/null || true; fi
  kill "$api_pid" 2>/dev/null || true
  wait "$executor_a_pid" "$executor_b_pid" "$api_pid" 2>/dev/null || true
}
trap cleanup EXIT

for _ in $(seq 1 100); do
  if curl --fail --silent http://127.0.0.1:8787/health >/dev/null; then break; fi
  if ! kill -0 "$api_pid" 2>/dev/null; then
    cat "$api_log" >&2
    exit 1
  fi
  sleep 0.05
done

if ! kill -0 "$api_pid" 2>/dev/null || ! curl --fail --silent http://127.0.0.1:8787/health >/dev/null; then
  echo "execution API did not become ready" >&2
  cat "$api_log" >&2
  exit 1
fi

SWARM_EXECUTOR_ID=process-a node dist/executor-daemon.js >"$executor_a_log" 2>&1 &
executor_a_pid=$!
SWARM_EXECUTOR_ID=process-b node dist/executor-daemon.js >"$executor_b_log" 2>&1 &
executor_b_pid=$!

node dist/distributed-demo.js
