#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
assets="$root/.data/firecracker"
mkdir -p "$assets"

for command in curl docker firecracker mke2fs; do
  command -v "$command" >/dev/null || {
    echo "missing $command; enter the Nix development shell with: nix develop" >&2
    exit 1
  }
done

if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
  echo "/dev/kvm is not readable and writable" >&2
  exit 1
fi

if [[ ! -f "$assets/vmlinux" ]]; then
  arch="$(uname -m)"
  s3="https://s3.amazonaws.com/spec.ccfc.min"
  prefix=$(curl -fsSL "$s3?list-type=2&prefix=firecracker-ci/&delimiter=/" \
    | grep -oP '(?<=<Prefix>)firecracker-ci/[0-9]{8}-[^/]+/(?=</Prefix>)' \
    | sort \
    | tail -1)
  kernel_key=$(curl -fsSL "$s3?list-type=2&prefix=${prefix}${arch}/vmlinux-" \
    | grep -oP "(?<=<Key>)(${prefix}${arch}/vmlinux-[0-9]+\\.[0-9]+\\.[0-9]{1,3})(?=</Key>)" \
    | sort -V \
    | tail -1)
  test -n "$kernel_key"
  echo "downloading $kernel_key"
  curl -fL "$s3/$kernel_key" -o "$assets/vmlinux"
fi

image="pi-agent-swarm-guest:local"
docker build -t "$image" "$root/firecracker"
container=$(docker create "$image")
work=$(mktemp -d)
trap 'docker rm -f "$container" >/dev/null 2>&1 || true; rm -rf "$work"' EXIT
mkdir -p "$work/rootfs"
docker export "$container" | tar -xf - -C "$work/rootfs"
truncate -s 768M "$assets/rootfs.ext4"
mke2fs -q -t ext4 -d "$work/rootfs" -F "$assets/rootfs.ext4"

echo "Firecracker assets are ready in $assets"
